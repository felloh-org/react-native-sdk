{
  "name": "@felloh-org/react-native-sdk",
  "version": "1.0.0",
  "description": "React Native SDK for Felloh payments",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/commonjs/index.js",
  "module": "dist/module/index.js",
  "types": "dist/typescript/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bob build",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "yarn build",
    "release": "semantic-release"
  },
  "keywords": [
    "react-native",
    "payments",
    "felloh",
    "payment-sdk",
    "webview"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felloh-org/react-native-sdk.git"
  },
  "author": "Felloh <developers@felloh.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/felloh-org/react-native-sdk/issues"
  },
  "homepage": "https://github.com/felloh-org/react-native-sdk#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-webview": ">=13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-flow": "^7.27.1",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-builder-bob": "^0.23.0",
    "react-native-webview": "^13.8.0",
    "react-test-renderer": "^18.2.0",
    "semantic-release": "^23.0.0",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "commonjs",
        {
          "copyFlow": false
        }
      ],
      [
        "module",
        {
          "copyFlow": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "eslintIgnore": [
    "dist/",
    "node_modules/"
  ]
}
